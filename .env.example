# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAYPAL_CLIENT_ID: PayPal Developer Sandbox Client ID for OAuth2 token generation.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"

# PAYPAL_CLIENT_SECRET: PayPal Developer Sandbox Client Secret for OAuth2 token generation.
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
